# All values below are OPTIONAL. A fresh install boots with no .env and walks you
# through setup in the browser (set a dashboard password, then connections). These
# env vars are only a fallback/override for the DB-stored settings. SECRET_KEY, if
# left unset, is auto-generated and persisted to a `secret_key` file next to the DB.
SONARR_URL=http://your-sonarr-host:8989
SONARR_API_KEY=your_sonarr_api_key
RADARR_URL=http://your-radarr-host:7878
RADARR_API_KEY=your_radarr_api_key
SFTP_HOST=192.168.x.x
SFTP_PORT=22
SFTP_USERNAME=your_sftp_user
SFTP_PASSWORD=your_sftp_password
HANDBRAKE_CLI=C:\path\to\HandBrakeCLI.exe
DATABASE_URL=sqlite:///transcoder.db
APP_PASSWORD=choose_a_dashboard_password
SECRET_KEY=generate_a_long_random_string

# Encoder family: auto | vcn | nvenc | qsv | cpu | custom (default auto — detects
# your hardware). Only consulted on a fresh install: once the app has booted the
# value lives in the DB and is edited on the Settings page.
ENCODER_FAMILY=auto

# Used ONLY when ENCODER_FAMILY=custom. Ignored for every other family, which
# picks its presets from the built-in catalog.
#PRESET_1080=H.265 NVENC 1080p
#PRESET_4K=H.265 NVENC 2160p 4K
